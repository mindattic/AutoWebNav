<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0: no WebView2 here, so logic built on IBrowserSurface stays unit-testable. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AutoWebNav</RootNamespace>
    <PackageId>AutoWebNav</PackageId>
    <Description>Browser-host-agnostic web automation: IBrowserSurface, the self-healing element fingerprint resolver, trusted-input element actions and the injected page toolkit.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- LogicalName pins the resource names ToolkitScripts.Load asks for, independent of folder layout. -->
    <EmbeddedResource Include="Scripts\*.js" LogicalName="AutoWebNav.Scripts.%(Filename)%(Extension)" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AutoWebNav.Tests" />
  </ItemGroup>

</Project>
